# All optional. The quiz works with none of these set.
NEXT_PUBLIC_SITE_URL=https://scenttype.app      # used for link-preview (OG) URLs
NEXT_PUBLIC_SITE_HOST=scenttype.app             # text printed on the share card
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                   # cookieless analytics (Plausible)
NEXT_PUBLIC_POSTHOG_KEY=                        # or PostHog, cookieless, no person profiles
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_PLACEHOLDER_LINKS=1                 # 0 = hide sample/buy buttons without curated URLs
FRAGRANCE_API_URL=                              # future Q2 search fallback (server-side only)
FRAGRANCE_API_KEY=
